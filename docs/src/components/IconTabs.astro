---
import { Tabs } from "@astrojs/starlight/components";

interface Props {
	/** Key used to keep multiple tab groups synchronized across pages. */
	syncKey?: string;
}

const { syncKey } = Astro.props;
---
<div class="icontabs">
	<Tabs syncKey={syncKey}>
		<slot />
	</Tabs>
</div>

<script>
	// IconTabItem stashes its astro-icon inside its panel (TabItem labels are
	// plain text). Move each icon into its matching tab button by label.
	for (const stash of document.querySelectorAll("[data-icontabs-icon]")) {
		const label = stash.getAttribute("data-icontabs-icon");
		const root = stash.closest("starlight-tabs");
		const svg = stash.querySelector("svg");
		const tab = [...(root?.querySelectorAll('[role="tab"]') ?? [])].find(
			(anchor) => anchor.textContent?.trim() === label,
		);
		if (tab && svg) tab.prepend(svg);
		stash.remove();
	}
</script>

<style is:global>
	/* Wrap the whole tab group in a bordered, rounded box like Nova's CodeTabs. */
	.icontabs {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
	}

	/* Read as a thin divider under the tab row, not the default heavy underline. */
	.icontabs [role="tablist"] {
		border-bottom-width: 1px;
	}

	/* Sit the active panel inside the border instead of floating below it. */
	.icontabs .tablist-wrapper ~ [role="tabpanel"] {
		margin: 0;
		padding: 0.75rem;
	}

	/* Give the tab buttons a bit more height than the native Starlight default. */
	.icontabs [role="tab"] {
		padding-top: 0.5rem;
		padding-bottom: 0.5rem;
	}

	/* Blend a code block's own border/radius into the container. */
	.icontabs .astro-code,
	.icontabs [data-nova-code-container] {
		border-radius: 0;
		border-width: 0;
		border-color: transparent;
	}

	.tab > [role="tab"] svg {
		width: 1.25em;
		height: 1.25em;
		flex-shrink: 0;
	}
</style>
